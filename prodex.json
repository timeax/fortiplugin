{
  "version": 3.1,
  "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
  "output": {
    "dir": ".prodex@forti"
  },
  "shortcuts": {
    "db-config-routes-schema": {
      "include": [
        "prisma/**",
        "schema/**",
        "config/**",
        "stubs"
      ]
    },
    "console-events-helpers-etc": {
      "include": [
        "src/Autoload/**",
        "src/Console/**",
        "src/Contracts/**",
        "src/Events/**",
        "src/Jobs/**",
        "src/Https/**",
        "src/Helpers/**",
        "src/Support/**",
        "src/Traits/**",
        "src/Facades/**",
        "src/Exceptions/**",
        "src/Ui/**"
      ]
    },
    "major-files": {
      "include": [
        "src/Core/**",
        "src/Permissions/**",
        "src/Runtime/**",
        "src/Services/**",
        "src/Lib/**",
        "src/FortiPluginServiceProvider.php",
        "src/EventServiceProvider.php",
        "src/Installations/**"
      ]
    },
    "tests": {
      "include": [
        "test/**"
      ]
    }
  }
}
