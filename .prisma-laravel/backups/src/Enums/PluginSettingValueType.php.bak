<?php

namespace Timeax\FortiPlugin\Enums;

enum PluginSettingValueType: string
{
	case string = "string";
	case number = "number";
	case boolean = "boolean";
	case json = "json";
	case file = "file";
	case blob = "blob";
	case tristate = "tristate";
	case multiselect = "multiselect";
	case select = "select";
	case checkbox = "checkbox";
	case radio = "radio";
	case chips = "chips";
}
